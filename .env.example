# =============================================================================
# Flowgate Automation - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# The defaults below point at public fake APIs, so the pipeline runs end to end
# with no accounts or credentials of your own.

# --- n8n Networking ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- n8n Execution ---
# n8n 1.9x warns on every boot without this flag; task runners become the
# default in a future release.
N8N_RUNNERS_ENABLED=true
# Prune old executions to save disk space (max age in hours, 168h = 7 days).
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
# The settings file is created world-readable; let n8n tighten it itself.
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- n8n Observability ---
N8N_METRICS=true
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
N8N_LOG_LEVEL=info

# --- Pipeline endpoints ---
# Source API: the users that will be extracted.
USERS_API_URL=https://jsonplaceholder.typicode.com/users
# Destination webhook: receives one POST per synced user.
# Point this at your real CRM endpoint in production.
CRM_WEBHOOK_URL=https://jsonplaceholder.typicode.com/posts

# --- Security ---
# There is no basic auth here. Access control is n8n's own user management: the
# first visit to the editor asks you to create the owner account. Do not expose
# this instance to the internet without HTTPS and a reverse proxy in front of it.
#
# n8n encrypts the credentials it stores with this key. Generate one with:
#   openssl rand -hex 32
# N8N_ENCRYPTION_KEY=
