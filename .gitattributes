# Normaliza fim de linha no repositório. Os scripts shell e o Makefile precisam
# continuar em LF mesmo quando o repositório é clonado no Windows — com CRLF o
# bash falha com "bad interpreter" e o make não reconhece as recipes.
* text=auto

*.sh text eol=lf
Makefile text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
